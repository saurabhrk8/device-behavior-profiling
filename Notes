package com.migration;

import java.io.*;
import java.nio.charset.StandardCharsets;
import java.nio.file.*;
import java.util.*;
import java.util.regex.*;
import java.util.zip.*;

public class ApigeeTransformer {

    public File transform(byte[] binContent, String apiId, String oasContent) throws Exception {
        String objectXml = "";
        String targetUrl = "";
        String definitionBody = "";
        String definitionName = "";
        long maxFileSize = -1;
        Set<String> actualPolicies = new LinkedHashSet<>();

        // 1. Extract Files from Akana ZIP
        try (ZipInputStream zis = new ZipInputStream(new ByteArrayInputStream(binContent))) {
            ZipEntry entry;
            while ((entry = zis.getNextEntry()) != null) {
                byte[] bytes = zis.readAllBytes();
                String name = entry.getName();

                if (name.toLowerCase().contains("objectdata.xml") || name.toLowerCase().contains("object.xml")) {
                    objectXml = new String(bytes, StandardCharsets.UTF_8);
                } else if (bytes.length > maxFileSize && (name.endsWith(".wsdl") || name.endsWith(".json"))) {
                    maxFileSize = bytes.length;
                    definitionBody = new String(bytes, StandardCharsets.UTF_8);
                    definitionName = name;
                }
            }
        }

        // 2. Metadata Extraction
        String apiName = extractValue(objectXml, "Name", "API_" + apiId);

        // 3. TARGETED POLICY EXTRACTION
        // We look for 'PolicyName' inside 'PolicyAttachment' or 'Assertion' blocks only
        Pattern p = Pattern.compile("<[^>]*?PolicyAttachment[^>]*?>.*?<[^>]*?PolicyName[^>]*?>(.*?)</[^>]*?PolicyName>", Pattern.DOTALL);
        Matcher m = p.matcher(objectXml);
        while (m.find()) {
            String pName = m.group(1).trim();
            // Filter out system noise (like localhost, visibility, etc)
            if (isValidPolicy(pName)) actualPolicies.add(pName);
        }

        // 4. WSDL TO OAS CONVERSION
        String oasYaml = "";
        if (definitionName.endsWith(".wsdl")) {
            targetUrl = extractRegex(definitionBody, "soap:address\\s+location=\"(.*?)\"");
            oasYaml = convertWsdlToOas(definitionBody, apiName, targetUrl);
        } else {
            oasYaml = definitionBody;
        }

        if (targetUrl.isEmpty()) targetUrl = extractTargetFromMeta(objectXml);

        return createApigeeBundle(apiName, targetUrl, oasYaml, actualPolicies);
    }

    private boolean isValidPolicy(String name) {
        String n = name.toLowerCase();
        // These are common Akana system objects that are NOT API policies
        List<String> blackList = Arrays.asList("visibility", "virtualhost", "uddi", "gateway", "domain", "host", "v1_");
        for (String b : blackList) if (n.contains(b)) return false;
        return name.length() > 2;
    }

    private String convertWsdlToOas(String wsdl, String name, String url) {
        StringBuilder sb = new StringBuilder("openapi: 3.0.0\ninfo:\n  title: " + name + "\n  version: 1.0.0\n");
        sb.append("servers:\n  - url: '").append(url.isEmpty() ? "http://backend" : url).append("'\npaths:\n");
        
        Matcher m = Pattern.compile("operation\\s+name=\"(.*?)\"").matcher(wsdl);
        Set<String> ops = new HashSet<>();
        while (m.find()) ops.add(m.group(1));
        
        if (ops.isEmpty()) ops.add("process");
        for (String op : ops) {
            sb.append("  /").append(op).append(":\n    post:\n      summary: ").append(op).append("\n      responses:\n        '200':\n          description: OK\n");
        }
        return sb.toString();
    }

    private String extractTargetFromMeta(String xml) {
        Pattern p = Pattern.compile("useType=\"endPoint\"[^>]*?>(.*?)</[\\w:]*?accessPoint>", Pattern.DOTALL);
        Matcher m = p.matcher(xml);
        return m.find() ? m.group(1).trim() : "https://mocktarget.apigee.net";
    }

    private String extractValue(String xml, String tag, String def) {
        Pattern p = Pattern.compile("<(?:\\w+:)??" + tag + ">(.*?)</(?:\\w+:)??" + tag + ">", Pattern.DOTALL);
        Matcher m = p.matcher(xml);
        return m.find() ? m.group(1).trim() : def;
    }

    private String extractRegex(String content, String regex) {
        Pattern p = Pattern.compile(regex, Pattern.CASE_INSENSITIVE);
        Matcher m = p.matcher(content);
        return m.find() ? m.group(1).trim() : "";
    }

    private File createApigeeBundle(String apiName, String targetUrl, String oasYaml, Set<String> policies) throws IOException {
        Path tempDir = Files.createTempDirectory("apigee_gen_");
        Path apiproxy = Files.createDirectories(tempDir.resolve("apiproxy"));
        Path polDir = Files.createDirectories(apiproxy.resolve("policies"));
        Path proxDir = Files.createDirectories(apiproxy.resolve("proxies"));
        Path targDir = Files.createDirectories(apiproxy.resolve("targets"));
        Path resDir = Files.createDirectories(apiproxy.resolve("resources/oas"));

        StringBuilder polyManifest = new StringBuilder("<Policy>AM-Response-template</Policy>\n");
        StringBuilder preFlowSteps = new StringBuilder();

        for (String p : policies) {
            String clean = p.replaceAll("[^a-zA-Z0-9-_]", "_");
            polyManifest.append("    <Policy>").append(clean).append("</Policy>\n");
            preFlowSteps.append("      <Step><Name>").append(clean).append("</Name></Step>\n");

            // Map "Quota" in name to Quota Policy, else AssignMessage
            String type = clean.toLowerCase().contains("quota") ? "Quota" : "AssignMessage";
            String content = type.equals("Quota") ? 
                "<?xml version=\"1.0\" encoding=\"UTF-8\"?><Quota name=\""+clean+"\"><Allow count=\"100\"/><Interval>1</Interval><TimeUnit>second</TimeUnit></Quota>" :
                "<?xml version=\"1.0\" encoding=\"UTF-8\"?><AssignMessage name=\""+clean+"\"><AssignTo createNew=\"false\" type=\"request\"/></AssignMessage>";
            Files.writeString(polDir.resolve(clean + ".xml"), content);
        }

        // Response Template
        Files.writeString(polDir.resolve("AM-Response-template.xml"), 
            "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<AssignMessage name=\"AM-Response-template\">\n" +
            "  <Set><Payload contentType=\"application/json\">{\"Greeting\": \"Jai Ganesh\", \"timestamp\": \"{system.time}\"}</Payload></Set>\n" +
            "</AssignMessage>");

        // Component XMLs
        Files.writeString(proxDir.resolve("default.xml"), 
            "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<ProxyEndpoint name=\"default\">\n" +
            "  <PreFlow><Request>" + preFlowSteps.toString() + "</Request><Response><Step><Name>AM-Response-template</Name></Step></Response></PreFlow>\n" +
            "  <HTTPProxyConnection><BasePath>/v1/" + apiName + "</BasePath></HTTPProxyConnection>\n" +
            "  <RouteRule name=\"default\"><TargetEndpoint>default</TargetEndpoint></RouteRule>\n</ProxyEndpoint>");

        Files.writeString(targDir.resolve("default.xml"), 
            "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<TargetEndpoint name=\"default\">\n" +
            "  <HTTPTargetConnection><URL>" + targetUrl + "</URL></HTTPTargetConnection>\n</TargetEndpoint>");

        Files.writeString(apiproxy.resolve(apiName + ".xml"), 
            "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<APIProxy name=\"" + apiName + "\">\n" +
            "  <BasePaths>/v1/" + apiName + "</BasePaths>\n" +
            "  <Policies>" + polyManifest.toString() + "</Policies>\n" +
            "  <ProxyEndpoints><ProxyEndpoint>default</ProxyEndpoint></ProxyEndpoints>\n" +
            "  <TargetEndpoints><TargetEndpoint>default</TargetEndpoint></TargetEndpoints>\n</APIProxy>");

        if (!oasYaml.isEmpty()) Files.writeString(resDir.resolve("openapi.yaml"), oasYaml);

        File zipFile = new File(apiName + ".zip");
        try (ZipOutputStream zos = new ZipOutputStream(new FileOutputStream(zipFile))) {
            Files.walk(apiproxy).filter(p -> !Files.isDirectory(p)).forEach(p -> {
                try {
                    zos.putNextEntry(new ZipEntry(tempDir.relativize(p).toString().replace("\\", "/")));
                    Files.copy(p, zos);
                    zos.closeEntry();
                } catch (IOException e) { e.printStackTrace(); }
            });
        }
        return zipFile;
    }
}
