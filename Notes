package com.migration;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.dataformat.xml.XmlMapper;
import java.io.*;
import java.nio.file.*;
import java.util.zip.*;

public class ApigeeTransformer {
    private final XmlMapper xmlMapper = new XmlMapper();

    public File transform(byte[] binContent, String apiId) throws Exception {
        // 1. Extract object.xml
        String objectXml = "";
        try (ZipInputStream zis = new ZipInputStream(new ByteArrayInputStream(binContent))) {
            ZipEntry entry;
            while ((entry = zis.getNextEntry()) != null) {
                if (entry.getName().endsWith("object.xml")) {
                    objectXml = new String(zis.readAllBytes());
                    break;
                }
            }
        }

        if (objectXml.isEmpty()) throw new RuntimeException("object.xml not found in package!");

        // 2. Parse XML for Metadata
        JsonNode root = xmlMapper.readTree(objectXml.getBytes());
        String apiName = root.path("Name").asText("Migrated_" + apiId);
        
        // Create Folder Structure
        Path rootPath = Files.createTempDirectory("apiproxy_");
        Path apiproxy = Files.createDirectories(rootPath.resolve("apiproxy"));
        Files.createDirectories(apiproxy.resolve("proxies"));
        Files.createDirectories(apiproxy.resolve("targets"));

        // 3. Create Manifest
        Files.writeString(apiproxy.resolve(apiName + ".xml"), "<?xml version=\"1.0\" encoding=\"UTF-8\"?><APIProxy name=\"" + apiName + "\"/>");

        // 4. Create ProxyEndpoint
        String proxyContent = "<?xml version=\"1.0\" encoding=\"UTF-8\"?><ProxyEndpoint name=\"default\"><HTTPProxyConnection><BasePath>/" + apiName.toLowerCase() + "</BasePath></HTTPProxyConnection><RouteRule name=\"default\"><TargetEndpoint>default</TargetEndpoint></RouteRule></ProxyEndpoint>";
        Files.writeString(apiproxy.resolve("proxies/default.xml"), proxyContent);

        // 5. Create TargetEndpoint
        String targetContent = "<?xml version=\"1.0\" encoding=\"UTF-8\"?><TargetEndpoint name=\"default\"><HTTPTargetConnection><URL>http://mocktarget.apigee.net</URL></HTTPTargetConnection></TargetEndpoint>";
        Files.writeString(apiproxy.resolve("targets/default.xml"), targetContent);

        // 6. Zip everything
        File finalZip = new File(apiName + ".zip");
        try (ZipOutputStream zos = new ZipOutputStream(new FileOutputStream(finalZip))) {
            Files.walk(apiproxy).filter(p -> !Files.isDirectory(p)).forEach(p -> {
                try {
                    zos.putNextEntry(new ZipEntry(apiproxy.relativize(p).toString().replace("\\", "/")));
                    Files.copy(p, zos);
                    zos.closeEntry();
                } catch (IOException e) { e.printStackTrace(); }
            });
        }
        return finalZip;
    }
}
