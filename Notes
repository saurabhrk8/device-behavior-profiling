package com.migration;

import java.io.*;
import java.nio.charset.StandardCharsets;
import java.nio.file.*;
import java.util.*;
import java.util.regex.*;
import java.util.zip.*;

public class ApigeeTransformer {

    public File transform(byte[] binContent, String apiId, String oasContent) throws Exception {
        String objectXml = "";
        String discoveredTargetUrl = "";
        Set<String> realPolicies = new LinkedHashSet<>();

        // 1. Scan the Akana ZIP for Metadata and WSDLs
        try (ZipInputStream zis = new ZipInputStream(new ByteArrayInputStream(binContent))) {
            ZipEntry entry;
            while ((entry = zis.getNextEntry()) != null) {
                String entryName = entry.getName();
                byte[] content = zis.readAllBytes();
                
                if (entryName.toLowerCase().endsWith("objectdata.xml") || entryName.toLowerCase().endsWith("object.xml")) {
                    objectXml = new String(content, StandardCharsets.UTF_8);
                } 
                // Look into WSDLs for Target URL if not found in metadata
                else if (entryName.toLowerCase().endsWith(".wsdl")) {
                    String wsdl = new String(content, StandardCharsets.UTF_8);
                    String url = extractRegex(wsdl, "soap:address\\s+location=\"(.*?)\"");
                    if (!url.isEmpty()) discoveredTargetUrl = url;
                }
            }
        }

        // 2. Refined Extraction from objectdata.xml
        String apiName = extractTag(objectXml, "Name", "API_" + apiId);
        
        // Target URL from Metadata (Priority)
        String metaTarget = extractTargetUrl(objectXml);
        if (!metaTarget.isEmpty()) discoveredTargetUrl = metaTarget;

        // STRICT POLICY EXTRACTION
        // We only look for PolicyName tags that are inside a <PolicyAttachment> or <Policies> block
        Pattern p = Pattern.compile("<(?:\\w+:)?PolicyAttachment.*?>.*?<(?:\\w+:)?PolicyName>(.*?)</(?:\\w+:)?PolicyName>.*?</(?:\\w+:)?PolicyAttachment>", Pattern.DOTALL);
        Matcher m = p.matcher(objectXml);
        while (m.find()) {
            String pName = m.group(1).trim();
            // Filter out system garbage
            if (!pName.contains(".") && !pName.contains("uddi") && !pName.contains("gateway")) {
                realPolicies.add(pName);
            }
        }

        return createApigeeZip(apiName, discoveredTargetUrl, oasContent, realPolicies);
    }

    private String extractTag(String xml, String tag, String defaultVal) {
        Pattern p = Pattern.compile("<(?:\\w+:)??" + tag + ">(.*?)</(?:\\w+:)??" + tag + ">");
        Matcher m = p.matcher(xml);
        return m.find() ? m.group(1).trim() : defaultVal;
    }

    private String extractRegex(String content, String regex) {
        Pattern p = Pattern.compile(regex, Pattern.CASE_INSENSITIVE);
        Matcher m = p.matcher(content);
        return m.find() ? m.group(1).trim() : "";
    }

    private String extractTargetUrl(String xml) {
        Pattern p = Pattern.compile("<[\\w:]*?accessPoint\\s+[^>]*?useType=\"endPoint\"[^>]*?>(.*?)</[\\w:]*?accessPoint>", Pattern.DOTALL);
        Matcher m = p.matcher(xml);
        return m.find() ? m.group(1).trim() : "";
    }

    private File createApigeeZip(String apiName, String targetUrl, String oasContent, Set<String> policies) throws IOException {
        Path tempDir = Files.createTempDirectory("apigee_bundle_");
        Path apiproxy = Files.createDirectories(tempDir.resolve("apiproxy"));
        Path policiesDir = Files.createDirectories(apiproxy.resolve("policies"));
        Path proxiesDir = Files.createDirectories(apiproxy.resolve("proxies"));
        Path targetsDir = Files.createDirectories(apiproxy.resolve("targets"));

        // Match your hello-world structure
        StringBuilder polyManifest = new StringBuilder("<Policy>AM-Response-template</Policy>\n");
        StringBuilder requestSteps = new StringBuilder();

        for (String pName : policies) {
            String cleanName = pName.replaceAll("[^a-zA-Z0-9-_]", "_");
            polyManifest.append("    <Policy>").append(cleanName).append("</Policy>\n");
            requestSteps.append("      <Step><Name>").append(cleanName).append("</Name></Step>\n");

            // Generate dummy AssignMessage for each real Akana policy found
            String pXml = "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n" +
                          "<AssignMessage name=\"" + cleanName + "\">\n" +
                          "  <AssignTo createNew=\"false\" transport=\"http\" type=\"request\"/>\n" +
                          "</AssignMessage>";
            Files.writeString(policiesDir.resolve(cleanName + ".xml"), pXml);
        }

        // Add your requested Response template
        String amResponse = "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n" +
                "<AssignMessage name=\"AM-Response-template\">\n" +
                "  <Set>\n" +
                "    <Payload contentType=\"application/json\" variablePrefix=\"%\" variableSuffix=\"%\">\n" +
                "      {\"Greeting\": \"Jai Ganesh\", \"timestamp\": \"%system.time%\"}\n" +
                "    </Payload>\n" +
                "  </Set>\n" +
                "</AssignMessage>";
        Files.writeString(policiesDir.resolve("AM-Response-template.xml"), amResponse);

        // API Proxy Manifest
        Files.writeString(apiproxy.resolve(apiName + ".xml"), 
            "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n<APIProxy name=\"" + apiName + "\">\n" +
            "  <BasePaths>/" + apiName.toLowerCase() + "</BasePaths>\n" +
            "  <Policies>\n" + polyManifest.toString() + "  </Policies>\n" +
            "  <ProxyEndpoints><ProxyEndpoint>default</ProxyEndpoint></ProxyEndpoints>\n" +
            "  <TargetEndpoints><TargetEndpoint>default</TargetEndpoint></TargetEndpoints>\n</APIProxy>");

        // Proxy Endpoint
        Files.writeString(proxiesDir.resolve("default.xml"), 
            "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<ProxyEndpoint name=\"default\">\n" +
            "  <PreFlow><Request>" + requestSteps.toString() + "</Request>" +
            "  <Response><Step><Name>AM-Response-template</Name></Step></Response></PreFlow>\n" +
            "  <HTTPProxyConnection><BasePath>/" + apiName.toLowerCase() + "</BasePath></HTTPProxyConnection>\n" +
            "  <RouteRule name=\"default\"><TargetEndpoint>default</TargetEndpoint></RouteRule>\n</ProxyEndpoint>");

        // Target Endpoint
        Files.writeString(targetsDir.resolve("default.xml"), 
            "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<TargetEndpoint name=\"default\">\n" +
            "  <HTTPTargetConnection><URL>" + (targetUrl.isEmpty() ? "https://mocktarget.apigee.net" : targetUrl) + "</URL></HTTPTargetConnection>\n</TargetEndpoint>");

        // Final ZIP
        File zipFile = new File(apiName + ".zip");
        try (ZipOutputStream zos = new ZipOutputStream(new FileOutputStream(zipFile))) {
            Files.walk(apiproxy).filter(p -> !Files.isDirectory(p)).forEach(p -> {
                try {
                    zos.putNextEntry(new ZipEntry(tempDir.relativize(p).toString().replace("\\", "/")));
                    Files.copy(p, zos);
                    zos.closeEntry();
                } catch (IOException e) { e.printStackTrace(); }
            });
        }
        return zipFile;
    }
}
