package com.migration;

import java.net.*;
import java.net.http.*;
import java.util.*;
import java.util.stream.Collectors;

public class AkanaClient {
    private final String host;
    private final HttpClient client;
    private String csrfToken = "";
    private String authCookie = "";

    public AkanaClient(String host) {
        this.host = host;
        this.client = HttpClient.newBuilder()
                .cookieHandler(new CookieManager())
                .build();
    }

    public void login(String user, String pass, String domain) throws Exception {
        // Prepare Form URL Encoded data
        Map<String, String> formData = new HashMap<>();
        formData.put("identity_username", user);
        formData.put("secret_password", pass);
        formData.put("domain", domain);

        String formBody = formData.entrySet().stream()
                .map(e -> URLEncoder.encode(e.getKey(), java.nio.charset.StandardCharsets.UTF_8) + "=" +
                          URLEncoder.encode(e.getValue(), java.nio.charset.StandardCharsets.UTF_8))
                .collect(Collectors.joining("&"));

        HttpRequest request = HttpRequest.newBuilder()
                .uri(URI.create(host + "/api/login/ssLogin"))
                .header("Content-Type", "application/x-www-form-urlencoded")
                .header("Accept", "application/json")
                .POST(HttpRequest.BodyPublishers.ofString(formBody))
                .build();

        HttpResponse<String> response = client.send(request, HttpResponse.BodyHandlers.ofString());

        // Extract Tokens from Cookies
        List<String> cookies = response.headers().allValues("set-cookie");
        for (String cookie : cookies) {
            if (cookie.contains("AtmoAuthToken_bdn")) this.authCookie = cookie.split(";")[0];
            if (cookie.contains("Csrf-Token_bdn")) this.csrfToken = cookie.split(";")[0].split("=")[1];
        }

        if (response.statusCode() == 200) {
            System.out.println("✅ Login Successful. Session captured.");
        } else {
            throw new RuntimeException("Login failed! Status: " + response.statusCode());
        }
    }

    public byte[] downloadPackage(String apiId) throws Exception {
        HttpRequest request = HttpRequest.newBuilder()
                .uri(URI.create(host + "/api/apis/" + apiId + "/package"))
                .header("Csrf-Token_bdn", csrfToken)
                .header("Cookie", authCookie)
                .header("Accept", "application/octet-stream")
                .GET()
                .build();

        HttpResponse<byte[]> response = client.send(request, HttpResponse.BodyHandlers.ofByteArray());
        return response.body();
    }
}

