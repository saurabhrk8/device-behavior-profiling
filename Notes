<dependency>
    <groupId>com.fasterxml.jackson.dataformat</groupId>
    <artifactId>jackson-dataformat-xml</artifactId>
    <version>2.16.1</version>
</dependency>




package com.migration;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.dataformat.xml.XmlMapper;
import java.io.*;
import java.net.URI;
import java.net.http.*;
import java.nio.file.*;
import java.util.zip.*;

public class AkanaPackageTransformer {

    private final HttpClient client = HttpClient.newBuilder().cookieHandler(new java.net.CookieManager()).build();
    private final XmlMapper xmlMapper = new XmlMapper();

    public void migrate(String akanaUrl, String apiVersionId, String apigeeOrg, String token) throws Exception {
        // 1. Download the .bin package
        byte[] zipBytes = downloadPackage(akanaUrl + "/api/apis/versions/" + apiVersionId + "/package");
        
        // 2. Extract object.xml from the bytes
        String objectXml = extractFileFromZip(zipBytes, "object.xml");
        
        // 3. Parse XML for Metadata (Name and Target URL)
        JsonNode root = xmlMapper.readTree(objectXml.getBytes());
        String apiName = root.path("Name").asText("Migrated_API");
        // Note: You might need to adjust the path below based on your specific Akana XML structure
        String targetEndPoint = root.findValue("ServiceAddress").asText("http://default-target.com");

        System.out.println("📦 Processing API: " + apiName);

        // 4. Create Apigee Bundle Structure
        File apigeeZip = createApigeeBundle(apiName, targetEndPoint);
        
        // 5. Upload to Apigee
        uploadToApigee(apigeeOrg, apiName, apigeeZip, token);
    }

    private byte[] downloadPackage(String url) throws Exception {
        HttpRequest request = HttpRequest.newBuilder().uri(URI.create(url)).GET().build();
        return client.send(request, HttpResponse.BodyHandlers.ofByteArray()).body();
    }

    private String extractFileFromZip(byte[] zipData, String fileName) throws IOException {
        try (ZipInputStream zis = new ZipInputStream(new ByteArrayInputStream(zipData))) {
            ZipEntry entry;
            while ((entry = zis.getNextEntry()) != null) {
                if (entry.getName().equals(fileName)) {
                    return new String(zis.readAllBytes());
                }
            }
        }
        throw new FileNotFoundException("Could not find " + fileName + " in Akana package");
    }

    private File createApigeeBundle(String name, String targetUrl) throws IOException {
        Path tempDir = Files.createTempDirectory("apigee-bundle-");
        Path apiProxyDir = Files.createDirectories(tempDir.resolve("apiproxy"));
        
        // Create Proxies & Targets folders
        Files.createDirectories(apiProxyDir.resolve("proxies"));
        Files.createDirectories(apiProxyDir.resolve("targets"));

        // 1. Main Proxy XML
        Files.writeString(apiProxyDir.resolve(name + ".xml"), 
            "<?xml version=\"1.0\" encoding=\"UTF-8\"?><APIProxy name=\"" + name + "\"/>");

        // 2. Default Target (Pointing to Akana's Backend)
        String targetXml = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" +
                "<TargetEndpoint name=\"default\">\n" +
                "  <HTTPTargetConnection><URL>" + targetUrl + "</URL></HTTPTargetConnection>\n" +
                "</TargetEndpoint>";
        Files.writeString(apiProxyDir.resolve("targets/default.xml"), targetXml);

        // 3. Default Proxy Endpoint
        String proxyXml = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" +
                "<ProxyEndpoint name=\"default\">\n" +
                "  <HTTPProxyConnection><BasePath>/" + name.toLowerCase().replace(" ", "-") + "</BasePath></HTTPProxyConnection>\n" +
                "  <RouteRule name=\"default\"><TargetEndpoint>default</TargetEndpoint></RouteRule>\n" +
                "</ProxyEndpoint>";
        Files.writeString(apiProxyDir.resolve("proxies/default.xml"), proxyXml);

        // Zip it up
        File zipFile = new File(name + "-apigee.zip");
        zipFolder(apiProxyDir, zipFile.toPath());
        return zipFile;
    }

    private void zipFolder(Path source, Path target) throws IOException {
        try (ZipOutputStream zos = new ZipOutputStream(new FileOutputStream(target.toFile()))) {
            Files.walk(source).filter(path -> !Files.isDirectory(path)).forEach(path -> {
                try {
                    zos.putNextEntry(new ZipEntry(source.relativize(path).toString().replace("\\", "/")));
                    Files.copy(path, zos);
                    zos.closeEntry();
                } catch (IOException e) { e.printStackTrace(); }
            });
        }
    }

    private void uploadToApigee(String org, String name, File zip, String token) throws Exception {
        // ... (Use the same upload logic from our previous conversation)
        System.out.println("✅ Successfully uploaded " + name + " to Apigee.");
    }
}
