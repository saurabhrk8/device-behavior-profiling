package com.migration;

import java.io.*;
import java.nio.charset.StandardCharsets;
import java.nio.file.*;
import java.util.*;
import java.util.regex.*;
import java.util.zip.*;

public class ApigeeTransformer {

    public File transform(byte[] binContent, String apiId, String oasContent) throws Exception {
        String xmlContent = "";
        
        // 1. Extract Akana Metadata (object.xml)
        if (binContent != null && binContent.length > 0) {
            try (ZipInputStream zis = new ZipInputStream(new ByteArrayInputStream(binContent))) {
                ZipEntry entry;
                while ((entry = zis.getNextEntry()) != null) {
                    String name = entry.getName().toLowerCase();
                    if (name.endsWith("objectdata.xml") || name.endsWith("object.xml")) {
                        xmlContent = new String(zis.readAllBytes(), StandardCharsets.UTF_8);
                        break;
                    }
                }
            }
        }

        // 2. Extract Data using Regex (Ignores namespaces like ns5: or ns16:)
        String apiName = extractValue(xmlContent, "Name", "API_" + apiId);
        String targetUrl = extractTargetUrl(xmlContent);
        List<String> policies = extractPolicies(xmlContent);

        // 3. Create the Apigee Bundle
        return createApigeeZip(apiName, targetUrl, oasContent, policies);
    }

    private String extractValue(String xml, String tag, String defaultValue) {
        Pattern p = Pattern.compile("<(?:\\w+:)??" + tag + ">(.*?)</(?:\\w+:)??" + tag + ">", Pattern.DOTALL);
        Matcher m = p.matcher(xml);
        return m.find() ? m.group(1).trim() : defaultValue;
    }

    private String extractTargetUrl(String xml) {
        // Specifically looks for <accessPoint useType="endPoint"> regardless of namespace
        Pattern p = Pattern.compile("<[\\w:]*?accessPoint\\s+[^>]*?useType=\"endPoint\"[^>]*?>(.*?)</[\\w:]*?accessPoint>", Pattern.DOTALL);
        Matcher m = p.matcher(xml);
        if (m.find()) return m.group(1).trim();
        
        // Fallback: look for any URL inside accessPoint
        return extractValue(xml, "accessPoint", "https://backend-not-found.com");
    }

    private List<String> extractPolicies(String xml) {
        Set<String> policyNames = new LinkedHashSet<>();
        // Searches for PolicyName tags inside the XML
        Pattern p = Pattern.compile("<(?:\\w+:)??" + "PolicyName" + ">(.*?)</(?:\\w+:)??" + "PolicyName" + ">");
        Matcher m = p.matcher(xml);
        while (m.find()) {
            policyNames.add(m.group(1).trim());
        }
        return new ArrayList<>(policyNames);
    }

    private File createApigeeZip(String apiName, String targetUrl, String oasContent, List<String> policies) throws IOException {
        Path tempDir = Files.createTempDirectory("apigee_bundle_");
        Path apiproxy = Files.createDirectories(tempDir.resolve("apiproxy"));
        Path policiesDir = Files.createDirectories(apiproxy.resolve("policies"));
        Path proxiesDir = Files.createDirectories(apiproxy.resolve("proxies"));
        Path targetsDir = Files.createDirectories(apiproxy.resolve("targets"));

        // A. Generate Manifest (apiproxy/name.xml)
        StringBuilder polyEntries = new StringBuilder();
        for (String p : policies) polyEntries.append("    <Policy>").append(p).append("</Policy>\n");

        String manifest = "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n" +
                "<APIProxy name=\"" + apiName + "\">\n" +
                "  <BasePaths>/" + apiName.toLowerCase() + "</BasePaths>\n" +
                "  <Policies>\n" + polyEntries.toString() + "  </Policies>\n" +
                "  <ProxyEndpoints><ProxyEndpoint>default</ProxyEndpoint></ProxyEndpoints>\n" +
                "  <TargetEndpoints><TargetEndpoint>default</TargetEndpoint></TargetEndpoints>\n" +
                "</APIProxy>";
        Files.writeString(apiproxy.resolve(apiName + ".xml"), manifest);

        // B. Generate Policy Files (Exactly as they appear in Akana)
        for (String pName : policies) {
            String pXml = "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n" +
                          "<AssignMessage name=\"" + pName + "\">\n" +
                          "  <DisplayName>" + pName + "</DisplayName>\n" +
                          "  <AssignTo createNew=\"false\" transport=\"http\" type=\"request\"/>\n" +
                          "</AssignMessage>";
            Files.writeString(policiesDir.resolve(pName + ".xml"), pXml);
        }

        // C. Generate Proxy Endpoint (default.xml)
        StringBuilder steps = new StringBuilder();
        for (String p : policies) steps.append("      <Step><Name>").append(p).append("</Name></Step>\n");

        String proxyXml = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" +
                "<ProxyEndpoint name=\"default\">\n" +
                "  <PreFlow name=\"PreFlow\">\n" +
                "    <Request>\n" + steps.toString() + "    </Request>\n" +
                "    <Response/>\n" +
                "  </PreFlow>\n" +
                "  <HTTPProxyConnection><BasePath>/" + apiName.toLowerCase() + "</BasePath></HTTPProxyConnection>\n" +
                "  <RouteRule name=\"default\"><TargetEndpoint>default</TargetEndpoint></RouteRule>\n" +
                "</ProxyEndpoint>";
        Files.writeString(proxiesDir.resolve("default.xml"), proxyXml);

        // D. Generate Target Endpoint (Using extracted Akana URL)
        String targetXml = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" +
                "<TargetEndpoint name=\"default\">\n" +
                "  <HTTPTargetConnection>\n" +
                "    <URL>" + targetUrl + "</URL>\n" +
                "  </HTTPTargetConnection>\n" +
                "</TargetEndpoint>";
        Files.writeString(targetsDir.resolve("default.xml"), targetXml);

        // ZIP Logic
        File zipFile = new File(apiName + ".zip");
        try (ZipOutputStream zos = new ZipOutputStream(new FileOutputStream(zipFile))) {
            Files.walk(apiproxy).filter(p -> !Files.isDirectory(p)).forEach(p -> {
                try {
                    zos.putNextEntry(new ZipEntry(tempDir.relativize(p).toString().replace("\\", "/")));
                    Files.copy(p, zos);
                    zos.closeEntry();
                } catch (IOException e) { e.printStackTrace(); }
            });
        }
        return zipFile;
    }
}
