package com.migration;

import java.io.File;
import java.util.Scanner;

public class MigratorApp {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        
        try {
            System.out.print("Enter Akana Host (e.g., https://akana.corp.com): ");
            String host = scanner.nextLine();
            
            System.out.print("Enter Domain: ");
            String domain = scanner.nextLine();

            System.out.print("Enter Username: ");
            String user = scanner.nextLine();

            System.out.print("Enter Password: ");
            // In a real terminal, you'd use System.console().readPassword()
            String pass = scanner.nextLine();

            System.out.print("Enter Akana API ID to migrate: ");
            String apiId = scanner.nextLine();

            // Execute Flow
            AkanaClient akana = new AkanaClient(host);
            akana.login(user, pass, domain);

            System.out.println("⏳ Downloading package...");
            byte[] binData = akana.downloadPackage(apiId);
            
            System.out.println("⏳ Transforming to Apigee bundle...");
            ApigeeTransformer transformer = new ApigeeTransformer();
            File apigeeBundle = transformer.transform(binData, apiId);

            System.out.println("✅ DONE! Created Apigee bundle: " + apigeeBundle.getAbsolutePath());
            System.out.println("Next step: Import this ZIP into your Apigee UI.");

        } catch (Exception e) {
            System.err.println("❌ Error: " + e.getMessage());
            e.printStackTrace();
        } finally {
            scanner.close();
        }
    }
}
