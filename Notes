package com.migration;

import java.io.*;
import java.nio.charset.StandardCharsets;
import java.nio.file.*;
import java.util.*;
import java.util.regex.*;
import java.util.zip.*;

public class ApigeeTransformer {

    public File transform(byte[] binContent, String apiId) throws Exception {
        String objectXml = "";
        String targetUrl = "";
        String wsdlContent = "";
        long maxWsdlSize = -1;

        // 1. Extract Metadata from Akana ZIP
        try (ZipInputStream zis = new ZipInputStream(new ByteArrayInputStream(binContent))) {
            ZipEntry entry;
            while ((entry = zis.getNextEntry()) != null) {
                byte[] bytes = zis.readAllBytes();
                String name = entry.getName().toLowerCase();
                if (name.contains("objectdata.xml")) {
                    objectXml = new String(bytes, StandardCharsets.UTF_8);
                } else if (name.endsWith(".wsdl") && bytes.length > maxWsdlSize) {
                    maxWsdlSize = bytes.length;
                    wsdlContent = new String(bytes, StandardCharsets.UTF_8);
                }
            }
        }

        // 2. Identify API Details
        String apiName = extractValue(objectXml, "Name", "API_" + apiId).replaceAll("[^a-zA-Z0-9-]", "-");
        targetUrl = extractTargetUrl(objectXml, wsdlContent);

        return createApigeeBundle(apiName, targetUrl);
    }

    private File createApigeeBundle(String apiName, String targetUrl) throws IOException {
        Path tempDir = Files.createTempDirectory("apigee_bundle_");
        Path apiproxy = Files.createDirectories(tempDir.resolve("apiproxy"));
        Path polDir = Files.createDirectories(apiproxy.resolve("policies"));
        Path proxDir = Files.createDirectories(apiproxy.resolve("proxies"));
        Path targDir = Files.createDirectories(apiproxy.resolve("targets"));

        // Define policy list for the manifest and PreFlow
        List<String> policyNames = Arrays.asList(
            "SA-SpikeArrest", "Q-EnforceQuota", "CORS-Headers", "AC-IPRestriction", "AM-Response-template"
        );

        // 1. Spike Arrest Policy [Traffic Management]
        Files.writeString(polDir.resolve("SA-SpikeArrest.xml"), 
            "<SpikeArrest name=\"SA-SpikeArrest\">\n" +
            "    <DisplayName>SA-SpikeArrest</DisplayName>\n" +
            "    <Rate>10ps</Rate>\n" +
            "</SpikeArrest>");

        // 2. Quota Policy [Traffic Management]
        Files.writeString(polDir.resolve("Q-EnforceQuota.xml"), 
            "<Quota name=\"Q-EnforceQuota\" type=\"calendar\">\n" +
            "    <DisplayName>Q-EnforceQuota</DisplayName>\n" +
            "    <Allow count=\"2000\"/>\n" +
            "    <Interval>1</Interval>\n" +
            "    <TimeUnit>month</TimeUnit>\n" +
            "    <Distributed>true</Distributed>\n" +
            "    <Synchronous>true</Synchronous>\n" +
            "</Quota>");

        // 3. CORS Policy [Mediation]
        Files.writeString(polDir.resolve("CORS-Headers.xml"), 
            "<CORS name=\"CORS-Headers\">\n" +
            "    <DisplayName>CORS-Headers</DisplayName>\n" +
            "    <AllowOrigins>*</AllowOrigins>\n" +
            "    <AllowMethods>GET, PUT, POST, DELETE</AllowMethods>\n" +
            "    <AllowHeaders>origin, x-requested-with, accept, content-type</AllowHeaders>\n" +
            "</CORS>");

        // 4. Access Control [Security]
        Files.writeString(polDir.resolve("AC-IPRestriction.xml"), 
            "<AccessControl name=\"AC-IPRestriction\">\n" +
            "    <DisplayName>AC-IPRestriction</DisplayName>\n" +
            "    <IPRules noRuleMatchAction=\"ALLOW\">\n" +
            "        <MatchRule action=\"DENY\">\n" +
            "            <SourceAddress mask=\"24\">192.168.1.0</SourceAddress>\n" +
            "        </MatchRule>\n" +
            "    </IPRules>\n" +
            "</AccessControl>");

        // 5. Response Template (Jai Ganesh)
        Files.writeString(polDir.resolve("AM-Response-template.xml"), 
            "<AssignMessage name=\"AM-Response-template\">\n" +
            "    <DisplayName>AM-Response-template</DisplayName>\n" +
            "    <Set>\n" +
            "        <Payload contentType=\"application/json\" variablePrefix=\"%\" variableSuffix=\"%\">\n" +
            "            {\"Greeting\": \"Jai Ganesh\", \"api\": \"" + apiName + "\", \"timestamp\": \"%system.time%\"}\n" +
            "        </Payload>\n" +
            "    </Set>\n" +
            "    <AssignTo createNew=\"false\" transport=\"http\" type=\"response\"/>\n" +
            "</AssignMessage>");

        // Construct ProxyEndpoint with Policy Steps
        StringBuilder steps = new StringBuilder();
        for (String p : policyNames) {
            if (!p.equals("AM-Response-template")) steps.append("            <Step><Name>").append(p).append("</Name></Step>\n");
        }

        Files.writeString(proxDir.resolve("default.xml"), 
            "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<ProxyEndpoint name=\"default\">\n" +
            "    <PreFlow>\n" +
            "        <Request>\n" + steps + "        </Request>\n" +
            "        <Response>\n" +
            "            <Step><Name>AM-Response-template</Name></Step>\n" +
            "        </Response>\n" +
            "    </PreFlow>\n" +
            "    <HTTPProxyConnection>\n" +
            "        <BasePath>/v1/" + apiName.toLowerCase() + "</BasePath>\n" +
            "    </HTTPProxyConnection>\n" +
            "    <RouteRule name=\"default\"><TargetEndpoint>default</TargetEndpoint></RouteRule>\n" +
            "</ProxyEndpoint>");

        // Target Endpoint
        Files.writeString(targDir.resolve("default.xml"), 
            "<TargetEndpoint name=\"default\">\n" +
            "    <HTTPTargetConnection><URL>" + targetUrl + "</URL></HTTPTargetConnection>\n" +
            "</TargetEndpoint>");

        // APIProxy Manifest
        StringBuilder manifestPolicies = new StringBuilder();
        for (String p : policyNames) manifestPolicies.append("        <Policy>").append(p).append("</Policy>\n");

        Files.writeString(apiproxy.resolve(apiName + ".xml"), 
            "<APIProxy name=\"" + apiName + "\">\n" +
            "    <BasePaths>/v1/" + apiName.toLowerCase() + "</BasePaths>\n" +
            "    <Policies>\n" + manifestPolicies + "    </Policies>\n" +
            "    <ProxyEndpoints><ProxyEndpoint>default</ProxyEndpoint></ProxyEndpoints>\n" +
            "    <TargetEndpoints><TargetEndpoint>default</TargetEndpoint></TargetEndpoints>\n" +
            "</APIProxy>");

        // Final Zip Assembly
        File zipFile = new File(apiName + ".zip");
        try (ZipOutputStream zos = new ZipOutputStream(new FileOutputStream(zipFile))) {
            Files.walk(apiproxy).filter(p -> !Files.isDirectory(p)).forEach(p -> {
                try {
                    zos.putNextEntry(new ZipEntry(tempDir.relativize(p).toString().replace("\\", "/")));
                    Files.copy(p, zos);
                    zos.closeEntry();
                } catch (IOException e) { e.printStackTrace(); }
            });
        }
        return zipFile;
    }

    private String extractTargetUrl(String xml, String wsdl) {
        String url = extractRegex(wsdl, "soap:address\\s+location=\"(.*?)\"");
        if (url.isEmpty()) {
            Pattern p = Pattern.compile("useType=\"endPoint\"[^>]*?>(.*?)</[\\w:]*?accessPoint>", Pattern.DOTALL);
            Matcher m = p.matcher(xml);
            url = m.find() ? m.group(1).trim() : "https://mocktarget.apigee.net";
        }
        return url;
    }

    private String extractValue(String xml, String tag, String def) {
        Pattern p = Pattern.compile("<(?:\\w+:)??" + tag + ">(.*?)</(?:\\w+:)??" + tag + ">", Pattern.DOTALL);
        Matcher m = p.matcher(xml);
        return m.find() ? m.group(1).trim() : def;
    }

    private String extractRegex(String content, String regex) {
        if (content == null) return "";
        Pattern p = Pattern.compile(regex, Pattern.CASE_INSENSITIVE);
        Matcher m = p.matcher(content);
        return m.find() ? m.group(1).trim() : "";
    }
}
