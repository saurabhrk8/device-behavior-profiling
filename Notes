package com.migration;

import java.io.*;
import java.nio.charset.StandardCharsets;
import java.nio.file.*;
import java.util.*;
import java.util.regex.*;
import java.util.zip.*;

public class ApigeeTransformer {

    public File transform(byte[] binContent, String apiId) throws Exception {
        String objectXml = "";
        String targetUrl = "";
        String wsdlContent = "";
        long maxWsdlSize = -1;

        try (ZipInputStream zis = new ZipInputStream(new ByteArrayInputStream(binContent))) {
            ZipEntry entry;
            while ((entry = zis.getNextEntry()) != null) {
                byte[] bytes = zis.readAllBytes();
                String name = entry.getName().toLowerCase();
                if (name.contains("objectdata.xml")) {
                    objectXml = new String(bytes, StandardCharsets.UTF_8);
                } else if (name.endsWith(".wsdl") && bytes.length > maxWsdlSize) {
                    maxWsdlSize = bytes.length;
                    wsdlContent = new String(bytes, StandardCharsets.UTF_8);
                }
            }
        }

        String apiName = extractValue(objectXml, "Name", "API-" + apiId).replaceAll("[^a-zA-Z0-9-]", "-");
        targetUrl = extractTargetUrl(objectXml, wsdlContent);
        
        // Return the bundle with only Core Standard policies
        return createApigeeBundle(apiName, targetUrl);
    }

    private File createApigeeBundle(String apiName, String targetUrl) throws IOException {
        Path tempDir = Files.createTempDirectory("apigee_core_bundle_");
        Path apiproxy = Files.createDirectories(tempDir.resolve("apiproxy"));
        Path polDir = Files.createDirectories(apiproxy.resolve("policies"));
        Path proxDir = Files.createDirectories(apiproxy.resolve("proxies"));
        Path targDir = Files.createDirectories(apiproxy.resolve("targets"));

        // Only the absolute "Safe" Standard Policies for Base Tier
        Map<String, String> policyMap = new LinkedHashMap<>();

        // 1. Traffic Management (Safe)
        policyMap.put("SpikeArrest-1", "<SpikeArrest name=\"SpikeArrest-1\"><Rate>10ps</Rate></SpikeArrest>");
        
        // 2. Security (Standard IP filtering is usually safe)
        policyMap.put("AccessControl-1", "<AccessControl name=\"AccessControl-1\"><IPRules noRuleMatchAction=\"ALLOW\"><MatchRule action=\"DENY\"><SourceAddress mask=\"24\">192.168.1.0</SourceAddress></MatchRule></IPRules></AccessControl>");

        // 3. Mediation (Safe Core Transformation)
        policyMap.put("CORS-1", "<CORS name=\"CORS-1\"><AllowOrigins>*</AllowOrigins><AllowMethods>GET, POST, OPTIONS</AllowMethods></CORS>");
        policyMap.put("JSONtoXML-1", "<JSONToXML name=\"JSONtoXML-1\"><Source>request</Source><Options><ObjectRootElementName>Root</ObjectRootElementName></Options></JSONToXML>");
        policyMap.put("XMLtoJSON-1", "<XMLToJSON name=\"XMLtoJSON-1\"><Source>response</Source><Options><RecognizeNumber>true</RecognizeNumber></Options></XMLToJSON>");
        
        // 4. Basic Header/Message manipulation (Safe)
        policyMap.put("HTTPModifier-1", "<HTTPModifier name=\"HTTPModifier-1\"><Add><Headers><Header name=\"X-Migrated\">true</Header></Headers></Add><AssignTo createNew=\"false\" transport=\"http\" type=\"request\"/></HTTPModifier>");
        policyMap.put("AM-Response-template", "<AssignMessage name=\"AM-Response-template\"><Set><Payload contentType=\"application/json\">{\"Greeting\": \"Jai Ganesh\", \"api\": \"" + apiName + "\"}</Payload></Set></AssignMessage>");

        // Write policy files
        for (Map.Entry<String, String> entry : policyMap.entrySet()) {
            Files.writeString(polDir.resolve(entry.getKey() + ".xml"), entry.getValue());
        }

        // --- Build ProxyEndpoint ---
        String reqSteps = "            <Step><Name>SpikeArrest-1</Name></Step>\n" +
                          "            <Step><Name>AccessControl-1</Name></Step>\n" +
                          "            <Step><Name>CORS-1</Name></Step>\n" +
                          "            <Step><Name>JSONtoXML-1</Name></Step>\n" +
                          "            <Step><Name>HTTPModifier-1</Name></Step>\n";

        Files.writeString(proxDir.resolve("default.xml"), 
            "<ProxyEndpoint name=\"default\">\n<PreFlow><Request>\n" + reqSteps + "</Request>\n" +
            "<Response><Step><Name>XMLtoJSON-1</Name></Step><Step><Name>AM-Response-template</Name></Step></Response></PreFlow>\n" +
            "<HTTPProxyConnection><BasePath>/v1/" + apiName.toLowerCase() + "</BasePath></HTTPProxyConnection><RouteRule name=\"default\"><TargetEndpoint>default</TargetEndpoint></RouteRule></ProxyEndpoint>");

        // --- Build TargetEndpoint ---
        Files.writeString(targDir.resolve("default.xml"), "<TargetEndpoint name=\"default\"><HTTPTargetConnection><URL>" + targetUrl + "</URL></HTTPTargetConnection></TargetEndpoint>");

        // --- Build Manifest ---
        StringBuilder manifest = new StringBuilder();
        for (String p : policyMap.keySet()) manifest.append("        <Policy>").append(p).append("</Policy>\n");
        Files.writeString(apiproxy.resolve(apiName + ".xml"), 
            "<APIProxy name=\"" + apiName + "\">\n" +
            "    <Policies>\n" + manifest + "    </Policies>\n" +
            "    <ProxyEndpoints><ProxyEndpoint>default</ProxyEndpoint></ProxyEndpoints>\n" +
            "    <TargetEndpoints><TargetEndpoint>default</TargetEndpoint></TargetEndpoints>\n" +
            "</APIProxy>");

        // ZIP
        File zipFile = new File(apiName + ".zip");
        try (ZipOutputStream zos = new ZipOutputStream(new FileOutputStream(zipFile))) {
            Files.walk(apiproxy).filter(p -> !Files.isDirectory(p)).forEach(p -> {
                try {
                    zos.putNextEntry(new ZipEntry(tempDir.relativize(p).toString().replace("\\", "/")));
                    Files.copy(p, zos);
                    zos.closeEntry();
                } catch (IOException e) { }
            });
        }
        return zipFile;
    }

    private String extractTargetUrl(String xml, String wsdl) {
        String url = "";
        Matcher m = Pattern.compile("soap:address\\s+location=\"(.*?)\"", Pattern.CASE_INSENSITIVE).matcher(wsdl);
        if (m.find()) url = m.group(1).trim();
        if (url.isEmpty()) {
            Matcher m2 = Pattern.compile("useType=\"endPoint\"[^>]*?>(.*?)</", Pattern.DOTALL).matcher(xml);
            url = m2.find() ? m2.group(1).trim() : "https://mocktarget.apigee.net";
        }
        return url;
    }

    private String extractValue(String xml, String tag, String def) {
        Pattern p = Pattern.compile("<(?:\\w+:)??" + tag + ">(.*?)</", Pattern.DOTALL);
        Matcher m = p.matcher(xml);
        return m.find() ? m.group(1).trim() : def;
    }
}
