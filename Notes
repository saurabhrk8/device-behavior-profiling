package com.migration;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.dataformat.xml.XmlMapper;
import java.io.*;
import java.nio.charset.StandardCharsets;
import java.nio.file.*;
import java.util.zip.*;

public class ApigeeTransformer {
    private final XmlMapper xmlMapper = new XmlMapper();

    public File transform(byte[] binContent, String apiId, String oasContent) throws Exception {
        String xmlContent = "";
        
        // 1. Robust extraction of objectdata.xml
        if (binContent != null && binContent.length > 0) {
            try (ZipInputStream zis = new ZipInputStream(new ByteArrayInputStream(binContent))) {
                ZipEntry entry;
                while ((entry = zis.getNextEntry()) != null) {
                    if (entry.getName().toLowerCase().endsWith("objectdata.xml")) {
                        xmlContent = new String(zis.readAllBytes(), StandardCharsets.UTF_8);
                        break;
                    }
                }
            }
        }

        // 2. Safe Parsing with Fallbacks
        String apiName = "Migrated_API_" + apiId;
        String targetUrl = "https://backend-placeholder.com";

        if (xmlContent != null && !xmlContent.trim().isEmpty()) {
            try {
                JsonNode root = xmlMapper.readTree(xmlContent.getBytes());
                // findPath is safer than path() as it searches deep
                apiName = root.findPath("Name").asText(apiName).replaceAll("[^a-zA-Z0-9-_]", "_");
                targetUrl = root.findPath("ServiceAddress").asText(targetUrl);
            } catch (Exception e) {
                System.err.println("⚠️ Warning: Could not parse XML metadata. Using defaults.");
            }
        } else {
            System.err.println("⚠️ Warning: No objectdata.xml found in package. Using defaults.");
        }

        return createApigeeZip(apiName, targetUrl, oasContent);
    }

    private File createApigeeZip(String apiName, String targetUrl, String oasContent) throws IOException {
        Path tempDir = Files.createTempDirectory("apigee_bundle_");
        Path apiproxy = Files.createDirectories(tempDir.resolve("apiproxy"));
        
        // Mandatory Folders
        Path proxies = Files.createDirectories(apiproxy.resolve("proxies"));
        Path targets = Files.createDirectories(apiproxy.resolve("targets"));
        Files.createDirectories(apiproxy.resolve("policies"));
        Path oasDir = Files.createDirectories(apiproxy.resolve("resources/oas"));

        // A. Main Manifest
        Files.writeString(apiproxy.resolve(apiName + ".xml"), 
            "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n" +
            "<APIProxy name=\"" + apiName + "\">\n" +
            "    <ConfigurationVersion majorVersion=\"4\" minorVersion=\"0\"/>\n" +
            "    <DisplayName>" + apiName + "</DisplayName>\n" +
            "</APIProxy>");

        // B. Proxy Endpoint
        Files.writeString(proxies.resolve("default.xml"), 
            "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" +
            "<ProxyEndpoint name=\"default\">\n" +
            "    <HTTPProxyConnection>\n" +
            "        <BasePath>/" + apiName.toLowerCase() + "</BasePath>\n" +
            "    </HTTPProxyConnection>\n" +
            "    <RouteRule name=\"default\">\n" +
            "        <TargetEndpoint>default</TargetEndpoint>\n" +
            "    </RouteRule>\n" +
            "</ProxyEndpoint>");

        // C. Target Endpoint
        Files.writeString(targets.resolve("default.xml"), 
            "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" +
            "<TargetEndpoint name=\"default\">\n" +
            "    <HTTPTargetConnection>\n" +
            "        <URL>" + targetUrl + "</URL>\n" +
            "    </HTTPTargetConnection>\n" +
            "</TargetEndpoint>");

        // D. OAS Spec
        if (oasContent != null && !oasContent.trim().isEmpty()) {
            Files.writeString(oasDir.resolve("openapi.json"), oasContent);
            System.out.println("📄 OAS Spec added to bundle.");
        }

        // E. Zip generation
        File zipFile = new File(apiName + ".zip");
        try (ZipOutputStream zos = new ZipOutputStream(new FileOutputStream(zipFile))) {
            Files.walk(apiproxy).filter(p -> !Files.isDirectory(p)).forEach(p -> {
                try {
                    String zipEntryName = tempDir.relativize(p).toString().replace("\\", "/");
                    zos.putNextEntry(new ZipEntry(zipEntryName));
                    Files.copy(p, zos);
                    zos.closeEntry();
                } catch (IOException e) { e.printStackTrace(); }
            });
        }
        return zipFile;
    }
}
