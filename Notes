// ... after akana.downloadPackage(apiId)
byte[] binData = akana.downloadPackage(apiId);

// ADD THESE TWO LINES:
java.nio.file.Path debugPath = java.nio.file.Paths.get("debug_package.zip");
java.nio.file.Files.write(debugPath, binData);

System.out.println("📂 Raw package saved to: " + debugPath.toAbsolutePath());
