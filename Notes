package com.migration;

import java.io.File;

public class MigratorApp {
    public static void main(String[] args) {
        try {
            // Configuration (Update these!)
            String AKANA_HOST = "https://your-akana.com";
            String APIGEE_ORG = "your-apigee-org";
            String APIGEE_TOKEN = "your-access-token";

            AkanaClient akana = new AkanaClient(AKANA_HOST);
            ApigeeClient apigee = new ApigeeClient();

            // 1. Akana Step
            akana.login("username", "password");
            String oas = akana.fetchOAS("version-id-here");

            // 2. Apigee Step
            File bundle = apigee.createBundle("Migrated_API_v1", oas);
            apigee.upload(APIGEE_ORG, "Migrated_API_v1", bundle, APIGEE_TOKEN);

            System.out.println("✅ SUCCESS: Migration finished.");
        } catch (Exception e) {
            e.printStackTrace();
        }
    }
}
