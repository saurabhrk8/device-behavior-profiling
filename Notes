$env:AKANA_HOST="https://akana.corporate.com"
$env:AKANA_DOMAIN="Standard-Ldap"
$env:AKANA_USERNAME="admin"
$env:AKANA_PASSWORD="secure_password"
$env:API_ID="generation-and-delivery-corpoarte-lending"

java -cp ".;bin;lib/*" com.migration.MigratorAPP
