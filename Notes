package com.migration;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.dataformat.xml.XmlMapper;
import java.io.*;
import java.nio.charset.StandardCharsets;
import java.nio.file.*;
import java.util.*;
import java.util.zip.*;

public class ApigeeTransformer {
    private final XmlMapper xmlMapper = new XmlMapper();

    public File transform(byte[] binContent, String apiId, String oasContent) throws Exception {
        String xmlContent = "";
        List<String> akanaPolicies = new ArrayList<>();
        String targetUrl = "https://placeholder-target.com";
        String apiName = "API_" + apiId;

        // 1. Extract and Parse Akana Metadata
        if (binContent != null && binContent.length > 0) {
            try (ZipInputStream zis = new ZipInputStream(new ByteArrayInputStream(binContent))) {
                ZipEntry entry;
                while ((entry = zis.getNextEntry()) != null) {
                    if (entry.getName().toLowerCase().endsWith("objectdata.xml") || entry.getName().toLowerCase().endsWith("object.xml")) {
                        xmlContent = new String(zis.readAllBytes(), StandardCharsets.UTF_8);
                        break;
                    }
                }
            }
        }

        if (!xmlContent.isBlank()) {
            JsonNode root = xmlMapper.readTree(xmlContent.getBytes());
            
            // A. Extract Name
            apiName = root.findPath("Name").asText(apiName).replaceAll("[^a-zA-Z0-9-_]", "_");

            // B. Extract Real Target URL from <ns5:accessPoint useType="endPoint">
            // We use findParents to find the accessPoint node and verify useType
            List<JsonNode> accessPoints = root.findParents("accessPoint");
            for (JsonNode ap : accessPoints) {
                JsonNode node = ap.path("accessPoint");
                if (node.path("useType").asText().equals("endPoint")) {
                    targetUrl = node.asText();
                    break; 
                }
            }

            // C. Extract Policies
            root.findValues("PolicyName").forEach(p -> akanaPolicies.add(p.asText()));
        }

        return createApigeeZip(apiName, targetUrl, oasContent, akanaPolicies);
    }

    private File createApigeeZip(String apiName, String targetUrl, String oasContent, List<String> policies) throws IOException {
        Path tempDir = Files.createTempDirectory("apigee_bundle_");
        Path apiproxy = Files.createDirectories(tempDir.resolve("apiproxy"));
        Path policiesDir = Files.createDirectories(apiproxy.resolve("policies"));
        Path proxiesDir = Files.createDirectories(apiproxy.resolve("proxies"));
        Path targetsDir = Files.createDirectories(apiproxy.resolve("targets"));
        Path resOasDir = Files.createDirectories(apiproxy.resolve("resources/oas"));

        // 1. Manifest XML
        StringBuilder policyList = new StringBuilder("<Policy>AM-Response-template</Policy>\n");
        for (String p : policies) {
            policyList.append("    <Policy>").append(p).append("</Policy>\n");
        }

        String manifest = "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n" +
                "<APIProxy name=\"" + apiName + "\">\n" +
                "  <DisplayName>" + apiName + "</DisplayName>\n" +
                "  <BasePaths>/" + apiName.toLowerCase() + "</BasePaths>\n" +
                "  <Policies>\n" + policyList.toString() + "  </Policies>\n" +
                "  <ProxyEndpoints><ProxyEndpoint>default</ProxyEndpoint></ProxyEndpoints>\n" +
                "  <TargetEndpoints><TargetEndpoint>default</TargetEndpoint></TargetEndpoints>\n" +
                "</APIProxy>";
        Files.writeString(apiproxy.resolve(apiName + ".xml"), manifest);

        // 2. Generate Policies (Real templates)
        generatePolicyFiles(policiesDir, policies);

        // 3. Proxy Endpoint
        StringBuilder steps = new StringBuilder();
        for (String p : policies) {
            steps.append("      <Step><Name>").append(p).append("</Name></Step>\n");
        }
        
        String proxyXml = "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n" +
                "<ProxyEndpoint name=\"default\">\n" +
                "  <PreFlow name=\"PreFlow\">\n" +
                "    <Request>\n" + steps.toString() + "    </Request>\n" +
                "    <Response><Step><Name>AM-Response-template</Name></Step></Response>\n" +
                "  </PreFlow>\n" +
                "  <HTTPProxyConnection><BasePath>/" + apiName.toLowerCase() + "</BasePath></HTTPProxyConnection>\n" +
                "  <RouteRule name=\"default\"><TargetEndpoint>default</TargetEndpoint></RouteRule>\n" +
                "</ProxyEndpoint>";
        Files.writeString(proxiesDir.resolve("default.xml"), proxyXml);

        // 4. Target Endpoint (Using Real URL)
        String targetXml = "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n" +
                "<TargetEndpoint name=\"default\">\n" +
                "  <HTTPTargetConnection>\n" +
                "    <URL>" + targetUrl + "</URL>\n" +
                "  </HTTPTargetConnection>\n" +
                "</TargetEndpoint>";
        Files.writeString(targetsDir.resolve("default.xml"), targetXml);

        if (oasContent != null && !oasContent.isBlank()) {
            Files.writeString(resOasDir.resolve("openapi.json"), oasContent);
        }

        return finalizeZip(apiName, tempDir, apiproxy);
    }

    private void generatePolicyFiles(Path dir, List<String> policies) throws IOException {
        // Template Response Policy
        Files.writeString(dir.resolve("AM-Response-template.xml"), 
            "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n" +
            "<AssignMessage name=\"AM-Response-template\">\n" +
            "  <Set><Payload contentType=\"application/json\">{\"Greeting\": \"Jai Ganesh\"}</Payload></Set>\n" +
            "</AssignMessage>");

        for (String p : policies) {
            String content;
            if (p.toLowerCase().contains("quota")) {
                content = "<?xml version=\"1.0\" encoding=\"UTF-8\"?><Quota name=\""+p+"\"><Allow count=\"2000\"/><Interval>1</Interval><TimeUnit>month</TimeUnit></Quota>";
            } else if (p.toLowerCase().contains("security") || p.toLowerCase().contains("auth")) {
                content = "<?xml version=\"1.0\" encoding=\"UTF-8\"?><VerifyAPIKey name=\""+p+"\"><APIKey ref=\"request.header.apikey\"/></VerifyAPIKey>";
            } else {
                content = "<?xml version=\"1.0\" encoding=\"UTF-8\"?><AssignMessage name=\""+p+"\"><AssignTo createNew=\"false\" type=\"request\"/></AssignMessage>";
            }
            Files.writeString(dir.resolve(p + ".xml"), content);
        }
    }

    private File finalizeZip(String apiName, Path tempDir, Path apiproxy) throws IOException {
        File zipFile = new File(apiName + ".zip");
        try (ZipOutputStream zos = new ZipOutputStream(new FileOutputStream(zipFile))) {
            Files.walk(apiproxy).filter(p -> !Files.isDirectory(p)).forEach(p -> {
                try {
                    zos.putNextEntry(new ZipEntry(tempDir.relativize(p).toString().replace("\\", "/")));
                    Files.copy(p, zos);
                    zos.closeEntry();
                } catch (IOException e) { e.printStackTrace(); }
            });
        }
        return zipFile;
    }
}
