package com.migration;

import java.io.*;
import java.nio.charset.StandardCharsets;
import java.nio.file.*;
import java.util.*;
import java.util.regex.*;
import java.util.zip.*;

public class ApigeeTransformer {

    public File transform(byte[] binContent, String apiId) throws Exception {
        String objectXml = "";
        String wsdlContent = "";
        
        try (ZipInputStream zis = new ZipInputStream(new ByteArrayInputStream(binContent))) {
            ZipEntry entry;
            while ((entry = zis.getNextEntry()) != null) {
                byte[] bytes = zis.readAllBytes();
                String name = entry.getName().toLowerCase();
                if (name.contains("objectdata.xml")) {
                    objectXml = new String(bytes, StandardCharsets.UTF_8);
                } else if (name.endsWith(".wsdl")) {
                    wsdlContent = new String(bytes, StandardCharsets.UTF_8);
                }
            }
        }

        String apiName = extractValue(objectXml, "Name", "API-" + apiId).replaceAll("[^a-zA-Z0-9-]", "-");
        String targetUrl = extractTargetUrl(objectXml, wsdlContent);
        String oasYaml = generateOasYaml(apiName, wsdlContent, targetUrl);

        return createApigeeBundle(apiName, targetUrl, oasYaml);
    }

    private String generateOasYaml(String name, String wsdl, String url) {
        StringBuilder yaml = new StringBuilder();
        yaml.append("openapi: 3.0.0\n");
        yaml.append("info:\n  title: ").append(name).append("\n  version: 1.0.0\n");
        yaml.append("servers:\n  - url: /v1/").append(name.toLowerCase()).append("\n");
        yaml.append("paths:\n  /:\n    post:\n      summary: SOAP Gateway Operation\n");
        yaml.append("      responses:\n        '200':\n          description: Successful response\n");
        
        Matcher m = Pattern.compile("operation name=\"(.*?)\"").matcher(wsdl);
        yaml.append("      x-soap-operations:\n");
        while (m.find()) {
            yaml.append("        - ").append(m.group(1)).append("\n");
        }
        return yaml.toString();
    }

    private File createApigeeBundle(String apiName, String targetUrl, String oasYaml) throws IOException {
        Path tempDir = Files.createTempDirectory("apigee_bundle_v4_");
        Path apiproxy = Files.createDirectories(tempDir.resolve("apiproxy"));
        
        // --- NEW: Correct Apigee Resource Structure ---
        // Path: apiproxy/resources/oas/filename.yaml
        Path oasDir = Files.createDirectories(apiproxy.resolve("resources").resolve("oas"));
        String oasFileName = apiName + "-oas.yaml";
        Files.writeString(oasDir.resolve(oasFileName), oasYaml);

        // Standard directories
        Path polDir = Files.createDirectories(apiproxy.resolve("policies"));
        Path proxDir = Files.createDirectories(apiproxy.resolve("proxies"));
        Path targDir = Files.createDirectories(apiproxy.resolve("targets"));

        Map<String, String> policyMap = new LinkedHashMap<>();

        // 1. OAS Validation (Correctly referencing the resource)
        policyMap.put("OAS-Validation-1", 
            "<OASValidation name=\"OAS-Validation-1\">\n" +
            "    <OASResource>oas://" + oasFileName + "</OASResource>\n" +
            "</OASValidation>");

        // 2. XMLtoJSON (XSD Fix: Options Only)
        policyMap.put("XMLtoJSON-1", 
            "<XMLToJSON name=\"XMLtoJSON-1\">\n" +
            "    <Source>response</Source>\n" +
            "    <Options><RecognizeNumber>true</RecognizeNumber></Options>\n" +
            "</XMLToJSON>");

        // 3. SpikeArrest
        policyMap.put("SpikeArrest-1", "<SpikeArrest name=\"SpikeArrest-1\"><Rate>10ps</Rate></SpikeArrest>");

        for (Map.Entry<String, String> entry : policyMap.entrySet()) {
            Files.writeString(polDir.resolve(entry.getKey() + ".xml"), "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" + entry.getValue());
        }

        // Proxy Endpoint
        Files.writeString(proxDir.resolve("default.xml"), 
            "<ProxyEndpoint name=\"default\">\n<PreFlow><Request>\n" +
            "    <Step><Name>SpikeArrest-1</Name></Step>\n" +
            "    <Step><Name>OAS-Validation-1</Name></Step>\n" +
            "</Request>\n<Response><Step><Name>XMLtoJSON-1</Name></Step></Response></PreFlow>\n" +
            "<HTTPProxyConnection><BasePath>/v1/" + apiName.toLowerCase() + "</BasePath></HTTPProxyConnection>\n" +
            "<RouteRule name=\"default\"><TargetEndpoint>default</TargetEndpoint></RouteRule></ProxyEndpoint>");

        // Target Endpoint
        Files.writeString(targDir.resolve("default.xml"), 
            "<TargetEndpoint name=\"default\"><HTTPTargetConnection><URL>" + targetUrl + "</URL></HTTPTargetConnection></TargetEndpoint>");

        // API Proxy Manifest (Includes Resources section)
        StringBuilder mb = new StringBuilder();
        for (String p : policyMap.keySet()) mb.append("        <Policy>").append(p).append("</Policy>\n");
        
        Files.writeString(apiproxy.resolve(apiName + ".xml"), 
            "<APIProxy name=\"" + apiName + "\">\n" +
            "    <Basepaths>/v1/" + apiName.toLowerCase() + "</Basepaths>\n" +
            "    <Policies>\n" + mb + "    </Policies>\n" +
            "    <ProxyEndpoints><ProxyEndpoint>default</ProxyEndpoint></ProxyEndpoints>\n" +
            "    <TargetEndpoints><TargetEndpoint>default</TargetEndpoint></TargetEndpoints>\n" +
            "    <Resources>\n" +
            "        <Resource>oas://" + oasFileName + "</Resource>\n" +
            "    </Resources>\n" +
            "</APIProxy>");

        return zipBundle(tempDir, apiproxy, apiName);
    }

    private File zipBundle(Path tempDir, Path apiproxy, String apiName) throws IOException {
        File zipFile = new File(apiName + ".zip");
        try (ZipOutputStream zos = new ZipOutputStream(new FileOutputStream(zipFile))) {
            Files.walk(apiproxy).filter(p -> !Files.isDirectory(p)).forEach(p -> {
                try {
                    // Replace backslashes with forward slashes for ZIP compatibility
                    String zipPath = tempDir.relativize(p).toString().replace("\\", "/");
                    zos.putNextEntry(new ZipEntry(zipPath));
                    Files.copy(p, zos);
                    zos.closeEntry();
                } catch (IOException e) { }
            });
        }
        return zipFile;
    }

    private String extractTargetUrl(String xml, String wsdl) {
        List<String> urls = new ArrayList<>();
        Matcher m = Pattern.compile(">(https?://[^<]+)<").matcher(xml);
        while (m.find()) { urls.add(m.group(1).trim()); }
        for (String url : urls) { if (url.toLowerCase().contains("bap")) return url; }
        return urls.isEmpty() ? "https://mocktarget.apigee.net" : urls.get(0);
    }

    private String extractValue(String xml, String tag, String def) {
        Pattern p = Pattern.compile("<(?:\\w+:)??" + tag + ">(.*?)</", Pattern.DOTALL);
        Matcher m = p.matcher(xml);
        return m.find() ? m.group(1).trim() : def;
    }
}
