package com.migration;

import java.io.*;
import java.nio.charset.StandardCharsets;
import java.nio.file.*;
import java.util.*;
import java.util.regex.*;
import java.util.zip.*;

public class ApigeeTransformer {

    public File transform(byte[] binContent, String apiId, String oasContent) throws Exception {
        String objectXml = "";
        String discoveredTargetUrl = "";
        String largestDefContent = "";
        String largestDefName = "";
        long maxFileSize = -1;
        Set<String> identifiedPolicies = new LinkedHashSet<>();

        // 1. Unzip Akana Package and analyze files
        try (ZipInputStream zis = new ZipInputStream(new ByteArrayInputStream(binContent))) {
            ZipEntry entry;
            while ((entry = zis.getNextEntry()) != null) {
                byte[] bytes = zis.readAllBytes();
                String name = entry.getName();

                if (name.toLowerCase().contains("objectdata.xml") || name.toLowerCase().contains("object.xml")) {
                    objectXml = new String(bytes, StandardCharsets.UTF_8);
                } 
                // Capture WSDL or JSON (OAS)
                else if (bytes.length > maxFileSize && (name.endsWith(".wsdl") || name.endsWith(".json") || name.endsWith(".yaml"))) {
                    maxFileSize = bytes.length;
                    largestDefContent = new String(bytes, StandardCharsets.UTF_8);
                    largestDefName = name;
                }
            }
        }

        // 2. Extract Data from Metadata XML
        String apiName = extractValue(objectXml, "Name", "API_" + apiId);
        discoveredTargetUrl = extractTargetUrl(objectXml);

        // 3. BRUTE FORCE POLICY SCAN
        // This looks for any tag ending in "PolicyName" or "PolicyType" regardless of namespace
        Pattern polyPattern = Pattern.compile("<[^>]*?Policy(?:Name|Type)[^>]*?>(.*?)</[^>]*?Policy(?:Name|Type)>", Pattern.DOTALL);
        Matcher polyMatcher = polyPattern.matcher(objectXml);
        while (polyMatcher.find()) {
            String p = polyMatcher.group(1).trim();
            // Filter out system noise
            if (!p.isEmpty() && p.length() < 60 && !p.toLowerCase().contains("visibility")) {
                identifiedPolicies.add(p);
            }
        }

        // 4. Handle WSDL to OAS conversion
        String finalOasYaml = "";
        if (largestDefName.toLowerCase().endsWith(".wsdl")) {
            if (discoveredTargetUrl.isEmpty()) {
                discoveredTargetUrl = extractValue(largestDefContent, "soap:address\\s+location=\"(.*?)\"", "");
            }
            finalOasYaml = convertWsdlToOas(largestDefContent, apiName, discoveredTargetUrl);
        } else {
            finalOasYaml = largestDefContent;
        }

        return createApigeeZip(apiName, discoveredTargetUrl, finalOasYaml, identifiedPolicies);
    }

    private String convertWsdlToOas(String wsdl, String name, String url) {
        StringBuilder yaml = new StringBuilder();
        yaml.append("openapi: 3.0.0\ninfo:\n  title: ").append(name).append("\n  version: 1.0.0\n");
        yaml.append("servers:\n  - url: '").append(url).append("'\npaths:\n");

        // Extract Operations from WSDL to make OAS Paths
        Pattern opPattern = Pattern.compile("<[^>]*?operation\\s+name=\"(.*?)\"");
        Matcher m = opPattern.matcher(wsdl);
        Set<String> operations = new HashSet<>();
        while (m.find()) {
            operations.add(m.group(1));
        }

        if (operations.isEmpty()) {
            yaml.append("  /:\n    get:\n      responses:\n        '200':\n          description: OK\n");
        } else {
            for (String op : operations) {
                yaml.append("  /").append(op).append(":\n    post:\n      summary: ").append(op).append("\n      responses:\n        '200':\n          description: OK\n");
            }
        }
        return yaml.toString();
    }

    private String extractTargetUrl(String xml) {
        Pattern p = Pattern.compile("useType=\"endPoint\"[^>]*?>(.*?)</[\\w:]*?accessPoint>", Pattern.DOTALL);
        Matcher m = p.matcher(xml);
        return m.find() ? m.group(1).trim() : "";
    }

    private String extractValue(String content, String tagOrRegex, String def) {
        String regex = tagOrRegex.contains("\\") ? tagOrRegex : "<(?:\\w+:)??" + tagOrRegex + ">(.*?)</(?:\\w+:)??" + tagOrRegex + ">";
        Pattern p = Pattern.compile(regex, Pattern.DOTALL);
        Matcher m = p.matcher(content);
        return m.find() ? m.group(1).trim() : def;
    }

    private File createApigeeZip(String apiName, String targetUrl, String oasYaml, Set<String> policies) throws IOException {
        Path tempDir = Files.createTempDirectory("apigee_final_");
        Path apiproxy = Files.createDirectories(tempDir.resolve("apiproxy"));
        Path polDir = Files.createDirectories(apiproxy.resolve("policies"));
        Path proxDir = Files.createDirectories(apiproxy.resolve("proxies"));
        Path targDir = Files.createDirectories(apiproxy.resolve("targets"));
        Path resDir = Files.createDirectories(apiproxy.resolve("resources/oas"));

        StringBuilder polyEntries = new StringBuilder("<Policy>AM-Response-template</Policy>\n");
        StringBuilder steps = new StringBuilder();

        // Generate identified policies
        for (String p : policies) {
            String clean = p.replaceAll("[^a-zA-Z0-9-_]", "_");
            polyEntries.append("    <Policy>").append(clean).append("</Policy>\n");
            steps.append("      <Step><Name>").append(clean).append("</Name></Step>\n");

            Files.writeString(polDir.resolve(clean + ".xml"), 
                "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<AssignMessage name=\"" + clean + "\">\n" +
                "  <AssignTo createNew=\"false\" transport=\"http\" type=\"request\"/>\n</AssignMessage>");
        }

        // Response template
        Files.writeString(polDir.resolve("AM-Response-template.xml"), 
            "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<AssignMessage name=\"AM-Response-template\">\n" +
            "  <Set><Payload contentType=\"application/json\">{\"Greeting\": \"Jai Ganesh\", \"status\": \"Success\"}</Payload></Set>\n</AssignMessage>");

        // Manifest
        Files.writeString(apiproxy.resolve(apiName + ".xml"), 
            "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<APIProxy name=\"" + apiName + "\">\n" +
            "  <BasePaths>/" + apiName.toLowerCase() + "</BasePaths>\n" +
            "  <Policies>" + polyEntries.toString() + "</Policies>\n" +
            "  <ProxyEndpoints><ProxyEndpoint>default</ProxyEndpoint></ProxyEndpoints>\n" +
            "  <TargetEndpoints><TargetEndpoint>default</TargetEndpoint></TargetEndpoints>\n</APIProxy>");

        // Proxy Endpoint
        Files.writeString(proxDir.resolve("default.xml"), 
            "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<ProxyEndpoint name=\"default\">\n" +
            "  <PreFlow><Request>" + steps.toString() + "</Request><Response><Step><Name>AM-Response-template</Name></Step></Response></PreFlow>\n" +
            "  <HTTPProxyConnection><BasePath>/" + apiName.toLowerCase() + "</BasePath></HTTPProxyConnection>\n" +
            "  <RouteRule name=\"default\"><TargetEndpoint>default</TargetEndpoint></RouteRule>\n</ProxyEndpoint>");

        // Target Endpoint
        Files.writeString(targDir.resolve("default.xml"), 
            "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<TargetEndpoint name=\"default\">\n" +
            "  <HTTPTargetConnection><URL>" + (targetUrl.isEmpty() ? "https://mocktarget.apigee.net" : targetUrl) + "</URL></HTTPTargetConnection>\n</TargetEndpoint>");

        // OAS File
        if (!oasYaml.isEmpty()) {
            Files.writeString(resDir.resolve("openapi.yaml"), oasYaml);
        }

        // Zip
        File zipFile = new File(apiName + ".zip");
        try (ZipOutputStream zos = new ZipOutputStream(new FileOutputStream(zipFile))) {
            Files.walk(apiproxy).filter(p -> !Files.isDirectory(p)).forEach(p -> {
                try {
                    zos.putNextEntry(new ZipEntry(tempDir.relativize(p).toString().replace("\\", "/")));
                    Files.copy(p, zos);
                    zos.closeEntry();
                } catch (IOException e) { e.printStackTrace(); }
            });
        }
