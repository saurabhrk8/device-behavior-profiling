package com.migration;

import java.io.*;
import java.net.URI;
import java.net.http.*;
import java.nio.file.*;
import java.util.zip.*;

public class ApigeeClient {
    public File createBundle(String apiName, String oasContent) throws IOException {
        Path tempDir = Files.createTempDirectory("apigee-");
        Path apiProxyDir = Files.createDirectories(tempDir.resolve("apiproxy"));
        
        // 1. Write Proxy XML
        Files.writeString(apiProxyDir.resolve(apiName + ".xml"), 
            "<?xml version=\"1.0\" encoding=\"UTF-8\"?><APIProxy name=\"" + apiName + "\"/>");

        // 2. Write OAS resource
        Path resDir = Files.createDirectories(apiProxyDir.resolve("resources/oas"));
        Files.writeString(resDir.resolve("openapi.json"), oasContent);

        // 3. Zip it
        File zipFile = new File(apiName + ".zip");
        try (ZipOutputStream zos = new ZipOutputStream(new FileOutputStream(zipFile))) {
            Files.walk(apiProxyDir).filter(p -> !Files.isDirectory(p)).forEach(path -> {
                try {
                    zos.putNextEntry(new ZipEntry(tempDir.relativize(path).toString().replace("\\", "/")));
                    Files.copy(path, zos);
                    zos.closeEntry();
                } catch (IOException e) { e.printStackTrace(); }
            });
        }
        return zipFile;
    }

    public void upload(String org, String apiName, File zipFile, String token) throws Exception {
        String url = "https://apigee.googleapis.com/v1/organizations/" + org + "/apis?action=import&name=" + apiName;
        HttpClient client = HttpClient.newHttpClient();
        HttpRequest request = HttpRequest.newBuilder()
                .uri(URI.create(url))
                .header("Authorization", "Bearer " + token)
                .header("Content-Type", "application/octet-stream") // Simplified for this example
                .POST(HttpRequest.BodyPublishers.ofFile(zipFile.toPath()))
                .build();

        HttpResponse<String> resp = client.send(request, HttpResponse.BodyHandlers.ofString());
        System.out.println("🚀 Apigee Response: " + resp.statusCode() + " - " + resp.body());
    }
}
