package com.migration;

import java.io.File;
import java.util.Scanner;

public class MigratorApp {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        try {
            System.out.print("Enter Akana Host: "); String host = sc.nextLine();
            System.out.print("Enter Domain: "); String domain = sc.nextLine();
            System.out.print("Enter Username: "); String user = sc.nextLine();
            System.out.print("Enter Password: "); String pass = sc.nextLine();
            System.out.print("Enter API Version ID: "); String versionId = sc.nextLine();

            AkanaClient client = new AkanaClient(host);
            client.login(user, pass, domain);
            
            System.out.println("⏳ Downloading package...");
            byte[] pkg = client.downloadPackage(versionId);
            
            System.out.println("⏳ Fetching OAS definition...");
            String oas = client.fetchOAS(versionId, "SIT");

            ApigeeTransformer transformer = new ApigeeTransformer();
            File result = transformer.transform(pkg, versionId, oas);

            System.out.println("✅ DONE! Created: " + result.getAbsolutePath());
        } catch (Exception e) {
            e.printStackTrace();
        } finally {
            sc.close();
        }
    }
}
