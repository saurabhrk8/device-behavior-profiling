package com.migration;

import java.net.*;
import java.net.http.*;

public class AkanaClient {
    private final String host;
    private final HttpClient client;

    public AkanaClient(String host) {
        this.host = host;
        this.client = HttpClient.newBuilder().cookieHandler(new CookieManager()).build();
    }

    public void login(String user, String pass) throws Exception {
        String body = "{\"username\":\"" + user + "\", \"password\":\"" + pass + "\"}";
        sendRequest(host + "/api/login", "POST", body);
        System.out.println("✅ Logged into Akana");
    }

    public String fetchOAS(String versionId) throws Exception {
        return sendRequest(host + "/api/apis/versions/" + versionId + "/definition/oas3?Environment=Production", "GET", null);
    }

    private String sendRequest(String url, String method, String body) throws Exception {
        HttpRequest.Builder builder = HttpRequest.newBuilder().uri(URI.create(url)).header("Accept", "application/json");
        if (method.equals("POST")) builder.header("Content-Type", "application/json").POST(HttpRequest.BodyPublishers.ofString(body));
        else builder.GET();

        HttpResponse<String> response = client.send(builder.build(), HttpResponse.BodyHandlers.ofString());
        if (response.statusCode() >= 300) throw new RuntimeException("HTTP Error: " + response.statusCode());
        return response.body();
    }
}

