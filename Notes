Project_Name.zip
└── apiproxy/
    ├── [API_Name].xml          <-- The "Manifest" (Main config)
    ├── proxies/
    │   └── default.xml         <-- Inbound configuration (Basepath)
    ├── targets/
    │   └── default.xml         <-- Outbound configuration (Backend URL)
    ├── resources/              <-- (Optional) Scripts and schemas
    │   ├── jsc/                <-- JavaScript files
    │   └── oas/                <-- OpenAPI/Swagger files
    └── policies/               <-- (Optional) XML for specific logic
        ├── Verify-API-Key.xml
        └── Quota-Policy.xml
