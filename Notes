package com.migration;

import javax.net.ssl.SSLContext;
import javax.net.ssl.TrustManager;
import javax.net.ssl.X509TrustManager;
import java.net.CookieManager;
import java.net.URI;
import java.net.URLEncoder;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;
import java.nio.charset.StandardCharsets;
import java.security.SecureRandom;
import java.security.cert.X509Certificate;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.stream.Collectors;

public class AkanaClient {
    private final String host;
    private final HttpClient client;
    private String csrfToken = "";
    private String authCookie = "";

    public AkanaClient(String host) throws Exception {
        this.host = host.endsWith("/") ? host.substring(0, host.length() - 1) : host;

        TrustManager[] trustAllCerts = new TrustManager[]{
            new X509TrustManager() {
                public X509Certificate[] getAcceptedIssuers() { return null; }
                public void checkClientTrusted(X509Certificate[] certs, String authType) {}
                public void checkServerTrusted(X509Certificate[] certs, String authType) {}
            }
        };

        SSLContext sslContext = SSLContext.getInstance("TLS");
        sslContext.init(null, trustAllCerts, new SecureRandom());

        this.client = HttpClient.newBuilder()
                .sslContext(sslContext)
                .cookieHandler(new CookieManager())
                .build();
    }

    public void login(String user, String pass, String domain) throws Exception {
        String loginUrl = host + "/api/login/ssoLogin";
        Map<String, String> formData = new HashMap<>();
        formData.put("identity_username", user);
        formData.put("secret_password", pass);
        formData.put("domain", domain);

        String formBody = formData.entrySet().stream()
                .map(e -> URLEncoder.encode(e.getKey(), StandardCharsets.UTF_8) + "=" +
                          URLEncoder.encode(e.getValue(), StandardCharsets.UTF_8))
                .collect(Collectors.joining("&"));

        HttpRequest request = HttpRequest.newBuilder()
                .uri(URI.create(loginUrl))
                .header("Content-Type", "application/x-www-form-urlencoded")
                .POST(HttpRequest.BodyPublishers.ofString(formBody))
                .build();

        HttpResponse<String> response = client.send(request, HttpResponse.BodyHandlers.ofString());

        if (response.statusCode() == 200) {
            List<String> cookies = response.headers().allValues("set-cookie");
            for (String cookie : cookies) {
                if (cookie.contains("AtmoAuthToken_bdn")) this.authCookie = cookie.split(";")[0];
                if (cookie.contains("Csrf-Token_bdn")) {
                    String pair = cookie.split(";")[0];
                    if (pair.contains("=")) this.csrfToken = pair.split("=")[1];
                }
            }
            System.out.println("✅ Login Successful.");
        } else {
            throw new RuntimeException("Login failed: " + response.statusCode());
        }
    }

    public byte[] downloadPackage(String apiVersionId) throws Exception {
        String url = host + "/api/apis/versions/" + apiVersionId + "/package";
        HttpRequest request = HttpRequest.newBuilder()
                .uri(URI.create(url))
                .header("Csrf-Token_bdn", csrfToken)
                .header("Cookie", authCookie)
                .GET().build();
        HttpResponse<byte[]> resp = client.send(request, HttpResponse.BodyHandlers.ofByteArray());
        return resp.statusCode() == 200 ? resp.body() : null;
    }

    public String fetchOAS(String apiVersionId, String env) throws Exception {
        // Attempt 1: OAS3 with Env
        String res = tryGet(host + "/api/apis/versions/" + apiVersionId + "/definition/oas3?Environment=" + env);
        if (!res.isBlank()) return res;

        // Attempt 2: General Definition
        res = tryGet(host + "/api/apis/versions/" + apiVersionId + "/definition");
        if (!res.isBlank()) return res;

        // Attempt 3: OAS3 without Env query
        return tryGet(host + "/api/apis/versions/" + apiVersionId + "/definition/oas3");
    }

    private String tryGet(String url) throws Exception {
        HttpRequest request = HttpRequest.newBuilder()
                .uri(URI.create(url))
                .header("Csrf-Token_bdn", csrfToken)
                .header("Cookie", authCookie)
                .header("Accept", "application/json")
                .GET().build();
        HttpResponse<String> resp = client.send(request, HttpResponse.BodyHandlers.ofString());
        // Return blank if it's an error or returns HTML instead of JSON
        if (resp.statusCode() != 200 || resp.body().contains("<!DOCTYPE html>")) return "";
        return resp.body();
    }
}

